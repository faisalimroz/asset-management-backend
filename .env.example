# Company Asset Management Platform - Environment Configuration

# Server Settings
SERVER_PORT=8080
ENVIRONMENT=development

# Database Settings
# Options: "sqlite" (default, zero configuration needed) or "postgres"
DB_DRIVER=sqlite
DB_PATH=./asset_management.db

# PostgreSQL Settings (Used only when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=asset_management
DB_SSLMODE=disable

# Authentication & Security
JWT_SECRET=super-secret-company-asset-jwt-key-2026!
JWT_EXPIRATION_HOURS=24

# Auto-seed initial demo users and assets on startup (true/false)
AUTO_SEED=true
